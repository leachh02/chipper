# Chipper's settings for docker-compose.yml. Save this as .env next to it,
# then run docker compose up -d again after changing anything.

# Which version to run: latest, or a release such as 1.2
CHIPPER_VERSION=latest

# The port to open Chipper on
CHIPPER_PORT=8080

# Your Spotify app's client ID, to add Spotify (see SELF_HOSTING.md).
# Leave it empty for Watch Later only.
SPOTIFY_CLIENT_ID=

# Uncomment to also run the group-by-topic service (about 650 MB)
# COMPOSE_PROFILES=ai
