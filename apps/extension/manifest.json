{
  "name": "Chipper",
  "description": "Syncs your YouTube Watch Later playlist with Chipper",
  "version": "1.3",
  "manifest_version": 3,
  "key": "",
  "icons": {
    "16": "images/axe-icon-16.png",
    "32": "images/axe-icon-32.png",
    "48": "images/axe-icon-48.png",
    "128": "images/axe-icon-128.png"
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/playlist?list=WL"
      ],
      "js": [
        "scripts/yt-wl-playlist-script.js"
      ]
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://leachh02.github.io/chipper/*"
      ],
      "js": [
        "scripts/app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Chipper"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://leachh02.github.io/*"
    ]
  }
}
