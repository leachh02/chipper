# Copy to .env. Everything is optional: without a Spotify client ID,
# Chipper runs with YouTube only.

# Spotify: create an app at https://developer.spotify.com/dashboard and add
# http://127.0.0.1:5173/dashboard/spotify (and http://127.0.0.1:4173/dashboard/spotify
# if you use npm run preview) to its redirect URIs. See SELF_HOSTING.md.
VITE_SPOTIFY_CLIENT_ID=

# Only needed if you load the extension under a different ID, e.g. a published
# copy. Separate several IDs with commas; each is tried in turn.
# VITE_EXTENSIONS_ID=

# Sync with a Chipper server (apps/server) on port 8080. See CONTRIBUTING.md.
# VITE_SERVER=true

# Defaults, in case you need to change them
# VITE_SPOTIFY_REDIRECT_URL=<this site's address>/dashboard/spotify
# VITE_SPOTIFY_SCOPE=user-library-read user-read-playback-position
# VITE_SPOTIFY_AUTHORIZATION_ENDPOINT=https://accounts.spotify.com/authorize
# VITE_SPOTIFY_TOKEN_ENDPOINT=https://accounts.spotify.com/api/token
