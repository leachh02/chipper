# Copy to .env and fill in the blanks.

# ID of the Chipper extension, shown on chrome://extensions once you've
# loaded apps/extension as an unpacked extension.
VITE_EXTENSIONS_ID=

# Create an app at https://developer.spotify.com/dashboard and add the
# redirect URL below to its allowed redirect URIs. Spotify requires
# 127.0.0.1 rather than localhost. user-read-playback-position lets Chipper
# see how far through each saved podcast episode you are.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URL=http://127.0.0.1:5173/dashboard/spotify
VITE_SPOTIFY_AUTHORIZATION_ENDPOINT=https://accounts.spotify.com/authorize
VITE_SPOTIFY_TOKEN_ENDPOINT=https://accounts.spotify.com/api/token
VITE_SPOTIFY_SCOPE=user-library-read user-read-playback-position
